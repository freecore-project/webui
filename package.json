{
  "name": "truenas-webui",
  "version": "1.2.0",
  "license": "BSD",
  "description": "TrueNAS Angular WebUI",
  "homepage": "https://github.com/truenas/webui/",
  "scripts": {
    "ng": "ng",
    "rimraf": "rimraf",
    "changelog": "standard-changelog",
    "start": "yarn run generate_licenses && yarn run po2json && node node_modules/@angular/cli/bin/ng serve --configuration development-aot --proxy-config proxy.config.json",
    "start:dev:aot": "yarn run po2json && node node_modules/@angular/cli/bin/ng serve --configuration development-aot --proxy-config proxy.config.json",
    "start:dev": "yarn run po2json && ng serve --proxy-config proxy.config.json",
    "start:prod": "yarn run po2json && ng serve --configuration production",
    "start:prod:aot": "yarn run po2json && ng serve --configuration production",
    "build": "yarn run generate_licenses && yarn run po2json && yarn run clean:dist && node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng build",
    "build:prod": "node scripts/setup_prod.js && yarn run build -- --configuration production",
    "build:prod:aot": "yarn run build:prod --aot --base-href /ui/ && node scripts/verify_build.js",
    "test": "ng test",
    "lint": "ng lint",
    "snyk": "snyk test",
    "clean:dist": "yarn run rimraf dist",
    "clean:coverage": "yarn run rimraf coverage",
    "reinstall": "yarn run rimraf yarn.lock; yarn run rimraf node_modules; yarn cache clean -f; yarn install",
    "extract": "node scripts/extract_strings.js",
    "po2json": "node scripts/convert_po2json.js",
    "create_po_pr": "yarn run extract && node scripts/create_pr.js",
    "generate_licenses": "yarn licenses generate-disclaimer > src/assets/disclaimer.txt && yarn licenses list --json > src/assets/licenses.json",
    "generate_licenses_list": "yarn licenses list > licenses.txt",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/truenas/webui.git"
  },
  "bugs": {
    "url": "https://ixsystems.atlassian.net"
  },
  "private": true,
  "engines": {
    "node": "24.19.0",
    "yarn": ">=1.22.19 <2"
  },
  "dependencies": {
    "@ali-hm/angular-tree-component": "16.0.1",
