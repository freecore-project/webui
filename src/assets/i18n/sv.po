msgstr "API-nycklar"

msgid "API URL"
msgstr "API-URL"

msgid "ARN"
msgstr "ARN"

msgid "ATA Security User"
msgstr "ATA-säkerhetsanvändare"

msgid "AUTORID"
msgstr "AUTORID"

msgid "AWS Region"
msgstr "AWS-region"

msgid "Abort"
msgstr "Avbryt"

msgid "About"
msgstr "Om"

