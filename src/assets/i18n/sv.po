msgstr "Ange lösenord."

msgid ""
"Enter the <a href=\"https://docs.aws.amazon.com/sns/latest/dg/sms_supported-"
"countries.html\" target=\"_blank\">AWS account region</a>."
msgstr ""
"Ange <a href=\"https://docs.aws.amazon.com/sns/latest/dg/sms_supported-"
"countries.html\" target=\"_blank\">AWS-kontots region</a>."

msgid ""
"Enter the <a href=\"https://docs.influxdata.com/influxdb/\" "
"target=\"_blank\">InfluxDB</a> hostname."
msgstr ""
"Ange värdnamnet för <a href=\"https://docs.influxdata.com/influxdb/\" "
"target=\"_blank\">InfluxDB</a>."

