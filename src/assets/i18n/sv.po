msgstr "AD"

msgid "AD Timeout"
msgstr "Tidsgräns för AD"

msgid "ADD"
msgstr "LÄGG TILL"

msgid "AFP"
msgstr "AFP"

msgid "AFP3 Unix Privs"
msgstr "AFP3 Unix-behörigheter"

msgid "API Key"
msgstr "API-nyckel"

msgid "API Key or Password"
msgstr "API-nyckel eller lösenord"

