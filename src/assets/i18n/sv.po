msgstr "Lägg till ACME-certifikat"

msgid "Add API Key"
msgstr "Lägg till API-nyckel"

msgid "Add Additional Path"
msgstr "Lägg till ytterligare sökväg"

msgid "Add Alert Service"
msgstr "Lägg till aviseringstjänst"

