msgstr "Active Directory måste vara aktiverat innan nya domäner läggs till."

msgid "Active Media Subtype"
msgstr "Aktiv medieundertyp"

msgid "Active Media Type"
msgstr "Aktiv medietyp"

msgid "Adapter Type"
msgstr "Adaptertyp"

